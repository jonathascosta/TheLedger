{
  "name": "the-ledger",
  "version": "0.0.0",
  "private": true,
  "description": "The Ledger: Business Simulator, an idle business game drawn in an accounting notebook, for the web and iPhone.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": "^20.19.0 || >=22.13.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @ledger/game dev",
    "preview": "pnpm --filter @ledger/game preview",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "test": "vitest run --project engine --project game",
    "test:calibration": "vitest run --project calibration",
    "test:watch": "vitest",
    "prepare": "husky",
    "ios:sync": "pnpm --filter @ledger/game build && pnpm --filter @ledger/game exec cap sync ios",
    "test:e2e": "pnpm --filter @ledger/game test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  }
}
